{
  "hosting": {
    "site": "kkllai",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/nvidia/**",
        "run": {
          "serviceId": "nvidiaproxy",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/push/complete-todo",
        "run": {
          "serviceId": "completetodo",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/push/**",
        "run": {
          "serviceId": "pushcheck",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
